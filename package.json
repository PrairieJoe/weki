{
  "name": "weki",
  "version": "1.1.0",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "start:v2": "node scripts/start-v2.mjs",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/electron-e2e.test.mjs",
    "build": "vite build",
    "benchmark:search:v2": "node scripts/benchmark-search-v2.mjs",
    "runtime:semantic:install": "node scripts/install-semantic-runtime.mjs",
    "preview": "vite preview",
    "desktop": "electron .",
    "generate:icon": "node scripts/generate-icon.mjs",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.weki.desktop",
    "productName": "Weki",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "artifactName": "Weki-${version}-Setup.exe",
    "files": [
      "dist/**/*",
      "public/**/*",
      "src/**/*",
      "styles.css",
      "index.html",
      "server.mjs",
      "electron-main.cjs",
      "package.json",
      "node_modules/**/*",
      "!node_modules/@rhwp/**",
      "!dist/win-unpacked/**",
      "!test/**",
      "!docs/**",
      "!release/**",
      "!*-install*/**",
      "!*-userdata*/**",
      "!*-repro*/**",
      "!*-check*/**",
      "!server-diagnostic-data*/**",
      "!update-status-*/**",
      "!p0fix-*/**",
      "!rc-npm-cache/**",
      "!.weki-data/**"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "@rhwp/core": "0.8.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.52.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@napi-rs/canvas": "^1.0.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "better-sqlite3": "13.0.3",
    "express": "^5.2.1",
    "hwp.js": "^0.0.3",
    "jszip": "^3.10.1",
    "multer": "^2.3.0",
    "onnxruntime-node": "1.20.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0",
    "usearch": "2.26.2",
    "vite": "^7.3.6"
  }
}
